PORT=5000
# MongoDB Atlas – replace <db_password> with your Atlas user password
# MONGODB_URI=mongodb+srv://shifak1an:<db_password>@cluster0.n5xdkcj.mongodb.net/cyberquest?retryWrites=true&w=majority&appName=Cluster0
